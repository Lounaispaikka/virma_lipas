# Database connection
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=virma
DB_HOST=127.0.0.1
DB_PORT=5432

# Coordinate reference system of the imported geometries
EPSG=3067

# Log the debug messages
DEBUG=False

# Only import the places that are free to use
ONLY_FREE_USE=False

# Import all the sports places instead of only the updated ones
FULL_UPDATE=False

# Sentry error reporting, e.g. https://123@sentry.tt.utu.fi/10
SENTRY_DSN=

